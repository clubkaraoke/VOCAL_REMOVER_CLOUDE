# ========================
# MVSep Configuration
# ========================
# Tu API token de MVSep
# Obtén en: https://mvsep.com → Settings → API Keys
MVSEP_API_TOKEN=sk_live_YOUR_TOKEN_HERE

# ========================
# Server Configuration
# ========================
API_HOST=0.0.0.0
API_PORT=8000

# ========================
# Database
# ========================
DATABASE_URL=sqlite:///./app/spleeter.db

# ========================
# Directories
# ========================
UPLOAD_DIR=./app/uploads
OUTPUT_DIR=./app/output
SAMPLES_DIR=./app/samples
LOOPS_DIR=./app/loops

# ========================
# Optional: Features
# ========================
# Habilitador de debug (True/False)
DEBUG=True

# Máximo tamaño de archivo (en MB)
MAX_FILE_SIZE=500

# Máximo de proyectos a mostrar
MAX_PROJECTS=100

# ========================
# AWS S3 (opcional, para almacenamiento en cloud)
# ========================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
